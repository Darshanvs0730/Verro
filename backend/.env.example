# VÉRRO Commerce Backend Environment Configuration
# NEVER commit production secrets or credentials to source control.
#
# SECRET POLICY (fail-closed):
#   - In production, DOWNLOAD_TOKEN_SECRET, WEBHOOK_SECRET and PAYMENT_GATEWAY_SECRET
#     MUST be supplied with strong (>= 32 character) random values or the process refuses to start.
#   - In development/test, omitted secrets are replaced by an ephemeral per-process
#     random value (never a public literal). Tokens do not survive a restart.
#   - Generate values with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

NODE_ENV=development
PORT=4000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:4173

# Trusted reverse-proxy hop count (G-1). 0 (default) = trust no proxy at all, so
# X-Forwarded-For is ignored and req.ip is the socket address. Set this to the EXACT
# number of proxies in front of the service (usually 1 behind a single load balancer).
# A boolean/"true" value is deliberately NOT accepted: trusting every hop would let any
# client spoof its own IP and bypass all per-IP rate limits and brute-force bounds.
TRUST_PROXY_HOPS=0

# Database Configuration (SQLite local dev; PostgreSQL ready)
DATABASE_URL=./verro_commerce.sqlite

# YouPI-PG Sovereign Payment Gateway Configuration (https://github.com/youpi-pg/YouPI-PG)
# Options: 'youpi' (for real YouPI-PG rail) or 'development' (for mock dev rail)
PAYMENT_GATEWAY_PROVIDER=youpi
# YouPI-PG Payment Core API (default: http://localhost:6100)
PAYMENT_GATEWAY_BASE_URL=http://localhost:6100
# YouPI-PG Customer Checkout Portal (default: http://localhost:7000)
PAYMENT_GATEWAY_PORTAL_URL=http://localhost:7000
# Merchant Identifier assigned in YouPI Admin
PAYMENT_GATEWAY_MERCHANT_ID=00000000-0000-0000-0000-000000000001
# Merchant Receiving UPI VPA (Direct Settlement Account, e.g. dvs2004@slc)
PAYMENT_GATEWAY_MERCHANT_VPA=dvs2004@slc
# Merchant secret / webhook secret for signing & verifying webhooks
PAYMENT_GATEWAY_SECRET=
# Return URL on completed payment
PAYMENT_GATEWAY_RETURN_URL=http://localhost:4173/#order-success

# HMAC secret used to verify inbound payment webhook signatures (raw request body)
WEBHOOK_SECRET=

# Secure File Storage Configuration (Private Master Assets)
# In development: Local private filesystem outside public static web root
PRIVATE_STORAGE_PATH=./storage/private_masters
DOWNLOAD_TOKEN_SECRET=
# Signed download token lifetime (minutes)
DOWNLOAD_TOKEN_TTL_MINUTES=15

# Idempotency replay cache retention (minutes)
IDEMPOTENCY_TTL_MINUTES=1440

# Test fixture routes (POST /api/v1/test/...) can settle an order without money moving.
# FAIL-CLOSED: they require ALL THREE of NODE_ENV=test, ENABLE_TEST_ROUTES=true and a
# strong TEST_FIXTURE_TOKEN. Missing any one of them leaves the fixture COMPLETELY
# unmounted (HTTP 404) — never merely "forbidden".
ENABLE_TEST_ROUTES=false

# Shared secret required in the X-Test-Fixture-Token header whenever the fixture routes
# are enabled (minimum 16 characters, compared in constant time). Required for the
# automated E2E suite: node tests/e2e-commerce.test.js (which starts its own backend).
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TEST_FIXTURE_TOKEN=

# Allow rate-limit bypass in automated suites only. Never enable in production.
RATE_LIMIT_TEST_BYPASS=false

# Cloud Object Storage Configuration (For Production AWS S3 / Cloudflare R2)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=
